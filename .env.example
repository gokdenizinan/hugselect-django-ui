# Copy this file to .env for Docker Compose. Never commit real keys.
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Required for the normal feature-extraction path.
GEMINI_API_KEY=

# Optional deployment-wide model selection. A user's OpenAI key is entered
# only after Gemini quota exhaustion and is not stored by HugSelect.
OPENAI_FALLBACK_MODEL=gpt-4.1-mini

HUGSELECT_ES_URL=http://elasticsearch:9200
HUGSELECT_ES_INDEX=models_t7
